{
  "name": "typora-compatible-editor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Typora 兼容的 Markdown 编辑器：主题直接迁移、扩展语法、MathJax、Mermaid、多格式导出、图床上传",
  "main": "src/electron/main.js",
  "scripts": {
    "start": "node src/server/index.js",
    "build": "node scripts/build-vendor.js && node scripts/build-renderer.js",
    "test": "node --test --test-concurrency=1 tests/",
    "desktop": "electron .",
    "desktop:dev": "TYPORA_DEV=1 electron ."
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@mathjax/mathjax-bbm-font-extension": "^4.1.3",
    "@mathjax/mathjax-bboldx-font-extension": "^4.1.3",
    "@mathjax/mathjax-mhchem-font-extension": "^4.1.3",
    "@rokt33r/js-sequence-diagrams": "^2.0.6-2",
    "esbuild": "^0.28.2",
    "express": "^5.3.0",
    "flowchart.js": "^1.18.0",
    "highlight.js": "^11.12.0",
    "jquery": "^3.7.1",
    "markdown-it": "^14.1.0",
    "markdown-it-abbr": "^2.0.0",
    "markdown-it-anchor": "^10.0.0",
    "markdown-it-attrs": "^5.0.1",
    "markdown-it-container": "^4.0.0",
    "markdown-it-deflist": "^4.0.0",
    "markdown-it-emoji": "^3.1.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-front-matter": "^0.2.4",
    "markdown-it-ins": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-multimd-table": "^4.2.3",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "mathjax": "^4.1.3",
    "mermaid": "^12.2.0",
    "multer": "^2.4.0",
    "postcss-value-parser": "^4.2.0",
    "underscore": "^1.13.8"
  },
  "devDependencies": {
    "electron": "^44.7.2",
    "postcss": "^8.5.30"
  }
}
